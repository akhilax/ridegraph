// =====================================================================
// RideGraph - sample_data.cypher
// Synthetic Chennai demo data (same data as src/backend/seed.py).
// Run AFTER schema.cypher. MERGE makes it safe to run more than once.
// Demo passwords: riders = rider123, drivers = driver123 (stored as hashes).
// Ride timestamps are relative to the moment the script runs.
// =====================================================================

// ---------- Zones ----------
MERGE (z:Zone {zone_id: 'Z1'}) SET z.zone_name = 'T. Nagar', z.city = 'Chennai';
MERGE (z:Zone {zone_id: 'Z2'}) SET z.zone_name = 'Mylapore', z.city = 'Chennai';
MERGE (z:Zone {zone_id: 'Z3'}) SET z.zone_name = 'Anna Nagar', z.city = 'Chennai';
MERGE (z:Zone {zone_id: 'Z4'}) SET z.zone_name = 'Guindy', z.city = 'Chennai';
MERGE (z:Zone {zone_id: 'Z5'}) SET z.zone_name = 'Velachery', z.city = 'Chennai';
MERGE (z:Zone {zone_id: 'Z6'}) SET z.zone_name = 'Chennai Central', z.city = 'Chennai';

// ---------- Locations (each IN_ZONE one zone) ----------
MERGE (l:Location {location_id: 'L1'}) SET l.address = 'Pondy Bazaar, T. Nagar', l.latitude = 13.0418, l.longitude = 80.2341 WITH l MATCH (z:Zone {zone_id: 'Z1'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L2'}) SET l.address = 'Panagal Park, T. Nagar', l.latitude = 13.0382, l.longitude = 80.234 WITH l MATCH (z:Zone {zone_id: 'Z1'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L3'}) SET l.address = 'Mambalam Railway Station', l.latitude = 13.0383, l.longitude = 80.2203 WITH l MATCH (z:Zone {zone_id: 'Z1'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L4'}) SET l.address = 'Kapaleeshwarar Temple, Mylapore', l.latitude = 13.0337, l.longitude = 80.2697 WITH l MATCH (z:Zone {zone_id: 'Z2'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L5'}) SET l.address = 'Santhome Cathedral Basilica', l.latitude = 13.0336, l.longitude = 80.2792 WITH l MATCH (z:Zone {zone_id: 'Z2'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L6'}) SET l.address = 'Marina Lighthouse', l.latitude = 13.0409, l.longitude = 80.2825 WITH l MATCH (z:Zone {zone_id: 'Z2'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L7'}) SET l.address = 'Anna Nagar Tower Park', l.latitude = 13.085, l.longitude = 80.2101 WITH l MATCH (z:Zone {zone_id: 'Z3'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L8'}) SET l.address = 'VR Chennai Mall, Anna Nagar', l.latitude = 13.0802, l.longitude = 80.2007 WITH l MATCH (z:Zone {zone_id: 'Z3'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L9'}) SET l.address = 'Koyambedu Bus Terminus (CMBT)', l.latitude = 13.0694, l.longitude = 80.1948 WITH l MATCH (z:Zone {zone_id: 'Z3'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L10'}) SET l.address = 'Guindy National Park', l.latitude = 13.0067, l.longitude = 80.2206 WITH l MATCH (z:Zone {zone_id: 'Z4'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L11'}) SET l.address = 'Chennai International Airport', l.latitude = 12.9941, l.longitude = 80.1709 WITH l MATCH (z:Zone {zone_id: 'Z4'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L12'}) SET l.address = 'Phoenix Marketcity, Velachery', l.latitude = 12.9926, l.longitude = 80.218 WITH l MATCH (z:Zone {zone_id: 'Z5'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L13'}) SET l.address = 'Velachery MRTS Station', l.latitude = 12.9808, l.longitude = 80.2186 WITH l MATCH (z:Zone {zone_id: 'Z5'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L14'}) SET l.address = 'Chennai Central Railway Station', l.latitude = 13.0827, l.longitude = 80.2757 WITH l MATCH (z:Zone {zone_id: 'Z6'}) MERGE (l)-[:IN_ZONE]->(z);
MERGE (l:Location {location_id: 'L15'}) SET l.address = 'Government Museum, Egmore', l.latitude = 13.0732, l.longitude = 80.2564 WITH l MATCH (z:Zone {zone_id: 'Z6'}) MERGE (l)-[:IN_ZONE]->(z);

// ---------- Ride types ----------
MERGE (t:RideType {ride_type_id: 'RT1'}) SET t.type_name = 'Economy', t.base_fare = 40.0, t.per_km_rate = 12.0;
MERGE (t:RideType {ride_type_id: 'RT2'}) SET t.type_name = 'Premium', t.base_fare = 80.0, t.per_km_rate = 20.0;
MERGE (t:RideType {ride_type_id: 'RT3'}) SET t.type_name = 'Auto', t.base_fare = 30.0, t.per_km_rate = 10.0;
MERGE (t:RideType {ride_type_id: 'RT4'}) SET t.type_name = 'Bike', t.base_fare = 20.0, t.per_km_rate = 6.0;

// ---------- Promo codes ----------
MERGE (p:PromoCode {promo_id: 'P1'}) SET p.code = 'WELCOME20', p.discount_percent = 20;
MERGE (p:PromoCode {promo_id: 'P2'}) SET p.code = 'RIDE10', p.discount_percent = 10;
MERGE (p:PromoCode {promo_id: 'P3'}) SET p.code = 'SAVE15', p.discount_percent = 15;

