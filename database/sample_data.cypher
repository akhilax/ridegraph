// ---------- Derived value: driver rating_avg = average of received ratings ----------
MATCH (d:Driver)-[:ACCEPTED]->(:Ride)-[:HAS_RATING]->(rt:Rating)
WITH d, avg(rt.score) AS average
SET d.rating_avg = round(average * 100) / 100.0;

// ---------- Check: node counts per label ----------
MATCH (n) RETURN labels(n)[0] AS label, count(n) AS nodes ORDER BY label;
