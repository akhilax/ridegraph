// ---------- 24 historical rides with payments, ratings, promos, cancellations ----------
// R1: Pondy Bazaar, T. Nagar -> Kapaleeshwarar Temple, Mylapore (completed)
MATCH (u:User {user_id: 'U1'}), (t:RideType {ride_type_id: 'RT1'}), (pl:Location {location_id: 'L1'}), (dl:Location {location_id: 'L4'}) MERGE (r:Ride {ride_id: 'R1'}) ON CREATE SET r.requested_at = toString(localdatetime.truncate('second', localdatetime()) - duration({days: 30, hours: 1})) SET r.status = 'completed', r.distance_km = 3.96, r.fare_amount = 87.52 MERGE (u)-[:REQUESTED]->(r) MERGE (r)-[:OF_TYPE]->(t) MERGE (r)-[:PICKUP_AT]->(pl) MERGE (r)-[:DROPOFF_AT]->(dl);
MATCH (d:Driver {driver_id: 'D2'}), (r:Ride {ride_id: 'R1'}) MERGE (d)-[:ACCEPTED]->(r) MERGE (p:Payment {payment_id: 'PAY1'}) SET p.amount = 87.52, p.method = 'upi', p.status = 'paid' MERGE (r)-[:PAID_BY]->(p) MERGE (rt:Rating {rating_id: 'RT1'}) SET rt.score = 5, rt.comment = 'Smooth ride, polite driver' MERGE (r)-[:HAS_RATING]->(rt);
// R2: Panagal Park, T. Nagar -> Phoenix Marketcity, Velachery (completed)
MATCH (u:User {user_id: 'U2'}), (t:RideType {ride_type_id: 'RT2'}), (pl:Location {location_id: 'L2'}), (dl:Location {location_id: 'L12'}) MERGE (r:Ride {ride_id: 'R2'}) ON CREATE SET r.requested_at = toString(localdatetime.truncate('second', localdatetime()) - duration({days: 28, hours: 2})) SET r.status = 'completed', r.distance_km = 5.36, r.fare_amount = 168.48 MERGE (u)-[:REQUESTED]->(r) MERGE (r)-[:OF_TYPE]->(t) MERGE (r)-[:PICKUP_AT]->(pl) MERGE (r)-[:DROPOFF_AT]->(dl);
MATCH (r:Ride {ride_id: 'R2'}), (p:PromoCode {promo_id: 'P2'}) MERGE (r)-[:APPLIES]->(p);
MATCH (d:Driver {driver_id: 'D1'}), (r:Ride {ride_id: 'R2'}) MERGE (d)-[:ACCEPTED]->(r) MERGE (p:Payment {payment_id: 'PAY2'}) SET p.amount = 168.48, p.method = 'card', p.status = 'paid' MERGE (r)-[:PAID_BY]->(p) MERGE (rt:Rating {rating_id: 'RT2'}) SET rt.score = 4, rt.comment = 'Comfortable car' MERGE (r)-[:HAS_RATING]->(rt);
// R3: Kapaleeshwarar Temple, Mylapore -> Anna Nagar Tower Park (completed)
MATCH (u:User {user_id: 'U3'}), (t:RideType {ride_type_id: 'RT1'}), (pl:Location {location_id: 'L4'}), (dl:Location {location_id: 'L7'}) MERGE (r:Ride {ride_id: 'R3'}) ON CREATE SET r.requested_at = toString(localdatetime.truncate('second', localdatetime()) - duration({days: 27, hours: 3})) SET r.status = 'completed', r.distance_km = 8.61, r.fare_amount = 143.32 MERGE (u)-[:REQUESTED]->(r) MERGE (r)-[:OF_TYPE]->(t) MERGE (r)-[:PICKUP_AT]->(pl) MERGE (r)-[:DROPOFF_AT]->(dl);
MATCH (d:Driver {driver_id: 'D4'}), (r:Ride {ride_id: 'R3'}) MERGE (d)-[:ACCEPTED]->(r) MERGE (p:Payment {payment_id: 'PAY3'}) SET p.amount = 143.32, p.method = 'cash', p.status = 'paid' MERGE (r)-[:PAID_BY]->(p) MERGE (rt:Rating {rating_id: 'RT3'}) SET rt.score = 4, rt.comment = 'On time' MERGE (r)-[:HAS_RATING]->(rt);
// R4: Anna Nagar Tower Park -> VR Chennai Mall, Anna Nagar (completed)
MATCH (u:User {user_id: 'U4'}), (t:RideType {ride_type_id: 'RT3'}), (pl:Location {location_id: 'L7'}), (dl:Location {location_id: 'L8'}) MERGE (r:Ride {ride_id: 'R4'}) ON CREATE SET r.requested_at = toString(localdatetime.truncate('second', localdatetime()) - duration({days: 25, hours: 4})) SET r.status = 'completed', r.distance_km = 1.15, r.fare_amount = 33.2 MERGE (u)-[:REQUESTED]->(r) MERGE (r)-[:OF_TYPE]->(t) MERGE (r)-[:PICKUP_AT]->(pl) MERGE (r)-[:DROPOFF_AT]->(dl);
MATCH (r:Ride {ride_id: 'R4'}), (p:PromoCode {promo_id: 'P1'}) MERGE (r)-[:APPLIES]->(p);
MATCH (d:Driver {driver_id: 'D5'}), (r:Ride {ride_id: 'R4'}) MERGE (d)-[:ACCEPTED]->(r) MERGE (p:Payment {payment_id: 'PAY4'}) SET p.amount = 33.2, p.method = 'upi', p.status = 'paid' MERGE (r)-[:PAID_BY]->(p) MERGE (rt:Rating {rating_id: 'RT4'}) SET rt.score = 5, rt.comment = 'Quick trip' MERGE (r)-[:HAS_RATING]->(rt);
